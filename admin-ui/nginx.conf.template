# Processed by the official nginx image's envsubst-on-start entrypoint step (see
# Dockerfile) — ${IDX_GATEWAY_KEY} below is replaced with the real value from this
# container's environment (docker-compose passes it via env_file: ../.env) before
# nginx ever loads this file. Every other "$"-prefixed token here (nginx's own
# $host, $uri, ...) has no matching environment variable, so envsubst leaves it
# untouched — that's how the two kinds of "$" coexist safely in one file, per the
# nginx image's own documented behavior.
#
# Why proxy instead of calling the gateway straight from the browser: same-origin
# (this nginx serves both the static app and /api/) means no CORS handling needed,
# and the gateway's bearer key is injected here, server-side — it never reaches
# client-side JS or the browser's network tab.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS (127.0.0.11) + a variable in proxy_pass forces nginx
    # to re-resolve "agent-gateway" on each request (bounded by `valid`) instead
    # of once at startup — a static `proxy_pass http://agent-gateway:8000/` here
    # would cache the gateway container's IP for nginx's whole lifetime, so any
    # later `docker compose up`/restart of just that container (a new IP, same
    # name) leaves this proxy silently pointing at a dead address until admin-ui
    # itself restarts. Found live via a 502 "Host is unreachable" after rebuilding
    # agent-gateway without restarting admin-ui.
    resolver 127.0.0.11 valid=10s;

    # Login must be reachable while logged out, obviously. Exact-match locations
    # (`=`) win over the prefix match below regardless of file order, so these two
    # bypass the auth_request gate that everything else under /api/ goes through.
    location = /api/v1/auth/login {
        set $gateway_upstream agent-gateway:8000;
        proxy_pass http://$gateway_upstream/v1/auth/login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/v1/auth/logout {
        set $gateway_upstream agent-gateway:8000;
        proxy_pass http://$gateway_upstream/v1/auth/logout;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # `internal`: only reachable via another location's `auth_request`, never
    # directly from a client. Forwards the same request headers auth_request
    # subrequests carry by default (the client's original Cookie included), so no
    # explicit `proxy_set_header Cookie` is needed here.
    location = /auth/verify {
        internal;
        set $gateway_upstream agent-gateway:8000;
        proxy_pass http://$gateway_upstream/v1/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location /api/ {
        # Real per-request auth gate: before proxying anything else under /api/,
        # nginx fires the internal /auth/verify subrequest above (which checks the
        # browser's session cookie against gateway/main.py's verify_session()) and
        # only proceeds on a 2xx — anything else short-circuits straight to 401.
        # Without this, admin-ui had NO login at all: nginx injected the shared
        # gateway bearer key (below) into every request regardless of who was
        # looking at the page, so anyone who loaded the URL already had full
        # access. auth_request adds the missing "prove you're actually logged in"
        # check, native to nginx — no new dependency.
        auth_request /auth/verify;

        # proxy_pass to a variable (needed for dynamic re-resolution, see above)
        # loses nginx's normal "strip the location prefix" behavior for a
        # trailing-slash proxy_pass — found live (a request for /api/v1/memory
        # reached the gateway as literally /api/v1/memory, 404) — so the /api
        # prefix has to be stripped explicitly first.
        # `set` must come before `rewrite ... break` — `break` halts the rewrite
        # module's phase for this request, so a `set` placed after it never runs
        # (found live: "using uninitialized gateway_upstream variable").
        set $gateway_upstream agent-gateway:8000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$gateway_upstream;
        proxy_set_header Authorization "Bearer ${IDX_GATEWAY_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri /index.html;
    }
}

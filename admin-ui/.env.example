# Dev-only (npm run dev) — sets up vite.config.ts's proxy so the UI can reach a
# gateway running on your machine without CORS/auth trouble in the browser.
# Not used by the Docker build; that reads the *same-named* variables from the
# project root .env via docker-compose's env_file (see admin-ui/README.md).

GATEWAY_URL=http://localhost:8000
IDX_GATEWAY_KEY=devkey

# Gateway auth shared with whichever chat UI is used
IDX_GATEWAY_KEY=

# admin-ui login (gateway/main.py's /v1/auth/* — single admin password, timing-
# safe compared, never logged/echoed). Not hashed at rest: this .env file is
# already the trust boundary for every other secret above, and there is no
# separate password store to leak — see gateway/main.py's login() docstring.
ADMIN_PASSWORD=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sectors API — BASE_URL has a real default baked into data/config.py if left
# blank, but set explicitly here so it's visible rather than implicit.
SECTORS_API_KEY=
SECTORS_API_BASE_URL=https://api.sectors.app/v2/

# Postgres — HOST/PORT/DB/USER are fine as-is (Docker service names/defaults).
# PASSWORD is NOT optional despite the blank default below: the official
# postgres image refuses to even start on a fresh volume without one ("Database
# is uninitialized and superuser password is not specified") — confirmed live
# from a genuinely fresh `docker compose up`, real bug, not a hypothetical. Set
# it to any string, same as IDX_GATEWAY_KEY/ADMIN_PASSWORD below.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=idx_agent
POSTGRES_USER=idx_agent
POSTGRES_PASSWORD=

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Phoenix (observability)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
